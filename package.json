{
  "name": "api-testing-suite",
  "version": "1.0.0",
  "description": "API testing suite by Wondwosen Asegid, SDET: REST, GraphQL and gRPC contract tests plus k6 performance tests, with CI on a daily schedule.",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "test": "vitest run",
    "test:rest": "vitest run tests/rest",
    "test:graphql": "vitest run tests/graphql",
    "test:grpc": "vitest run tests/grpc",
    "test:all": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "grpc:server": "ts-node src/grpc/server.ts",
    "k6:load": "k6 run k6/load-test.js",
    "k6:stress": "k6 run k6/stress-test.js"
  },
  "devDependencies": {
    "@grpc/grpc-js": "^1.13.0",
    "@grpc/proto-loader": "^0.7.13",
    "@types/node": "^22.10.0",
    "axios": "^1.7.9",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "zod": "^3.23.8"
  }
}
